#!/bin/sh
# WiFi on the TB-7304X (MT6625L via CONSYS, driver mainline/wcn). Each step is skipped when already done.
#   wifi-up                     radio on, interface up (scan with: iw dev mt6625_0 scan)
#   wifi-up <ssid> <password>   ... and join (config in /tmp, RAM only), DHCP
#   wifi-up join                ... and join with /etc/wpa_supplicant/wpa_supplicant.conf, DHCP
#   wifi-up off                 leave, radio off
# Needs /etc/firmware (mainline/scripts/wifi-deploy.sh), wmt_loader + stp_uart_launcher in /usr/local/sbin,
# and the iw, wpa_supplicant packages. Logs in /tmp/wifi/. The board is 2.4 GHz only (its NVRAM disables 5 GHz).
IF=mt6625_0 L=/tmp/wifi
PATH=/usr/local/sbin:$PATH
mkdir -p $L
die() { echo "wifi-up: $*" >&2; exit 1; }
wait_for() { i=0; while ! eval "$1"; do i=$((i + 1)); [ $i -ge "$2" ] && return 1; sleep 1; done; }

if [ "$1" = off ]; then
	pkill -f "wpa_supplicant .*-i $IF" 2>/dev/null; pkill -f "udhcpc .*-i $IF" 2>/dev/null
	# wpa_supplicant deauthenticates before it exits; wait so a following wifi-up starts clean
	wait_for "! pgrep -f 'wpa_supplicant .*-i $IF' > /dev/null && ! pgrep -f 'udhcpc .*-i $IF' > /dev/null" 5 ||
		echo "wifi-up: wpa_supplicant/udhcpc still running" >&2
	[ -e /sys/class/net/$IF ] && ip link set $IF down
	[ -e /dev/wmtWifi ] && echo 0 > /dev/wmtWifi
	echo "wifi off"; exit 0
fi

[ -f /etc/firmware/WIFI_RAM_CODE ] || die "no /etc/firmware (run mainline/scripts/wifi-deploy.sh on the host)"
# 1. WMT core + WiFi char devices (built-in drivers, registered on request)
if [ ! -e /dev/stpwmt ]; then
	wmt_loader > $L/loader.log 2>&1 || die "wmt_loader failed, see $L/loader.log"
	wait_for '[ -e /dev/stpwmt ] && [ -e /dev/wmtWifi ]' 5 || die "no /dev/stpwmt after wmt_loader"
fi
# 2. launcher: powers CONSYS and hands the ROM patches to the driver; stays running
if ! pgrep -f stp_uart_launcher > /dev/null; then
	setsid stp_uart_launcher -p /etc/firmware < /dev/null > $L/launcher.log 2>&1 &
	sleep 5
fi
# 3. WiFi function: firmware download, netdev
if [ ! -e /sys/class/net/$IF ]; then
	echo 1 > /dev/wmtWifi || die "WiFi power on failed (dmesg)"
	wait_for "[ -e /sys/class/net/$IF ]" 10 || die "no $IF"
fi
ip link set $IF up || die "ip link set $IF up failed"
echo "$IF up, MAC $(cat /sys/class/net/$IF/address)"
[ $# -eq 0 ] && exit 0

# 4. join
if [ "$1" = join ]; then
	CONF=/etc/wpa_supplicant/wpa_supplicant.conf
	[ -f $CONF ] || die "no $CONF"
else
	[ $# -eq 2 ] || die "usage: wifi-up [off | join | <ssid> <password>]"
	CONF=$L/wpa.conf
	(umask 077; wpa_passphrase "$1" "$2" | grep -v '#psk' > $CONF) || die "wpa_passphrase failed"
fi
pkill -f "wpa_supplicant .*-i $IF" 2>/dev/null && wait_for "! pgrep -f 'wpa_supplicant .*-i $IF' > /dev/null" 5
# Alpine's wpa_supplicant has no -f; keep its output
setsid wpa_supplicant -t -i $IF -c $CONF -D nl80211 < /dev/null > $L/wpa.log 2>&1 &
wait_for "iw dev $IF link | grep -q Connected" 30 || die "not associated, see $L/wpa.log"
iw dev $IF link | sed -n 's/^\t\(SSID\|freq\|signal\): /  \1 /p'
# udhcpc stays running to renew the lease
pkill -f "udhcpc .*-i $IF" 2>/dev/null
setsid udhcpc -f -i $IF -t 5 -A 10 < /dev/null > $L/udhcpc.log 2>&1 &
wait_for "ip -4 addr show $IF | grep -q inet" 20 || die "no DHCP lease, see $L/udhcpc.log"
ip -4 addr show $IF | sed -n 's/^ *inet \([^ ]*\).*/  address \1/p'
