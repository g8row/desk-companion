#!/bin/sh
# tb-reboot [bootloader|recovery|android]: reboot the TB-7304X into LK fastboot, the recovery partition (= mainline),
# or Android (default). Sets LK's RTC boot flag (mtk-rtc-boot-mode), syncs, and reboots with sysrq because
# `reboot -f` can hang on this kernel.
M=${1:-android}
F=/sys/devices/platform/rtc-boot-mode/next_boot
[ -w $F ] || { echo "no $F (kernel without mtk-rtc-boot-mode)" >&2; exit 1; }
echo "$M" > $F || exit 1
echo "next boot: $(cat $F)"
sync
echo 1 > /proc/sys/kernel/sysrq
echo s > /proc/sysrq-trigger; sleep 1
echo u > /proc/sysrq-trigger; sleep 1
echo b > /proc/sysrq-trigger
