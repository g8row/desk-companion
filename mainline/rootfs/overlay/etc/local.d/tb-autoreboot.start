#!/bin/sh
# Safety net, same rules as stage 1:
#  - 60 s after reaching userspace the boot counts as good (stage 1 gives up on the rootfs after 2 bad ones).
#  - Reboot (back to Android) after tb.autoreboot= seconds (default 300) unless /tmp/stay or /run/stay exists.
#    /etc/tb-autoreboot overrides it; 0 turns it off. sysrq s,u,b because `reboot -f` can hang on this kernel.
T=300
for a in $(cat /proc/cmdline); do case "$a" in tb.autoreboot=*) T=${a#tb.autoreboot=} ;; esac; done
[ -f /etc/tb-autoreboot ] && T=$(cat /etc/tb-autoreboot)
(
	sleep 60
	echo 0 > /mnt/cache/linux/bootcount; sync
	t=60
	while [ "$T" -gt 0 ]; do
		sleep 5; t=$((t + 5))
		{ [ -e /tmp/stay ] || [ -e /run/stay ]; } && continue
		if [ $t -ge "$T" ]; then
			logger -t tb7304 "autoreboot after ${t}s"
			echo 1 > /proc/sys/kernel/sysrq
			echo s > /proc/sysrq-trigger; sleep 1; echo u > /proc/sysrq-trigger; sleep 1
			echo b > /proc/sysrq-trigger
		fi
	done
) </dev/null >/dev/null 2>&1 &
